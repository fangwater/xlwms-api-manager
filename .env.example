# Lingxing WMS OpenAPI endpoint.
XLWMS_API_BASE_URL=https://api.xlwms.com/openapi

# Credentials issued by Lingxing WMS. Never commit real values.
XLWMS_APP_KEY=your_app_key
XLWMS_APP_SECRET=your_app_secret

# OMS Web credentials used only by the backend to read and operate pending platform orders.
XLWMS_OMS_BASE_URL=https://oms.xlwms.com
XLWMS_OMS_USERNAME=your_oms_username
XLWMS_OMS_PASSWORD=your_oms_password

# Dedicated PostgreSQL database for XLWMS data.
DATABASE_URL=postgresql://xlwms_app:your_password@127.0.0.1:5432/xlwms

# Local-only management API and request limits.
XLWMS_LISTEN=127.0.0.1:18083
XLWMS_REQUEST_TIMEOUT=30s
XLWMS_SYNC_TIMEOUT=30m
XLWMS_FULFILLMENT_AUDIT_INTERVAL=1h
# Per-watermark batch size; pickup exceptions and regular tracking use separate batches.
XLWMS_FULFILLMENT_TRACKING_LIMIT=500
XLWMS_FULFILLMENT_TRACKING_CONCURRENCY=8

# Independent Temu Go service used for package tracking. It owns all Temu credentials and signing.
TEMU_GO_BASE_URL=http://127.0.0.1:18082/temu

# Local master key used to encrypt per-warehouse API credentials.
XLWMS_CREDENTIAL_KEY_FILE=/home/ubuntu/xlwms-api-manager/.warehouse_credentials_key

# Independent Go SHEIN service. Production reads the existing SHEIN database
# and Web session secret through scripts/run-shein-server.sh.
SHEIN_GO_LISTEN=127.0.0.1:18084
SHEIN_GO_REQUEST_TIMEOUT=30s
SHEIN_SHOP_KEY=default
SHEIN_GO_ALLOWED_USERS=pyy,operations,order-follow-up
SHEIN_DATABASE_URL=postgresql://shein_app:your_password@127.0.0.1:5432/shein
SHEIN_WEB_SESSION_SECRET_FILE=/home/ubuntu/shein-api-manager/.web_session_secret
